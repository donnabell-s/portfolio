{
  "name": "@portfolio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "tsc -p ../../packages/shared/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@portfolio/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "8.11.6",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
