# Neon connection string, e.g. postgresql://user:pass@ep-xxx.neon.tech/portfolio?sslmode=require
DATABASE_URL=

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Web app origin(s) allowed to call this API directly (comma-separated). In
# normal operation the browser never hits this origin directly — it goes
# through the Next.js rewrite proxy — but CORS is still enforced as
# defense-in-depth for anyone hitting the API domain directly.
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development
PORT=4000

# Used only by src/db/seed.ts to create the single admin user.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
