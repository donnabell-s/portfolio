# Server-side only — Server Components and the next.config.ts rewrite call
# the API directly at this URL. The browser never sees it; it always uses
# relative /api/* paths (see lib/api.ts and next.config.ts).
API_BASE_URL=http://localhost:4000

# Public — used for sitemap.xml, robots.txt, and OG/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
